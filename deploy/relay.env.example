# Companion relay hub secrets — TEMPLATE.
#
# This is the file the hub reads for its two shared tokens. Keep the real copy
# OUTSIDE the repository:
#
#   mkdir -p ~/.companion-relay && chmod 700 ~/.companion-relay
#   cp deploy/relay.env.example ~/.companion-relay/relay.env
#   # replace both placeholders with: openssl rand -hex 32
#   chmod 600 ~/.companion-relay/relay.env
#
# `install-relay-hub.sh` does the above for you if the file is missing.
#
# Consumed by:
#   companion relay hub            both values (flags --devices-token / --agents-token override)
#   companion relay devices|push   COMPANION_RELAY_AGENTS_TOKEN only
#
# NEVER commit the real file — it is a credential.

# Devices dial in with this token. It must match DEVICE_TOKEN in the board's
# config.local.h. Rotating it requires re-flashing the boards.
COMPANION_RELAY_DEVICES_TOKEN=replace-with-openssl-rand-hex-32

# Agents (your laptop, CI) dial in with this token. Rotating it is safe and
# does not touch the devices.
COMPANION_RELAY_AGENTS_TOKEN=replace-with-openssl-rand-hex-32
